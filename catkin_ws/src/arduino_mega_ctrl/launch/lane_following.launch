<launch>
       <!-- Start rosserial_python node for Arduino Mega -->
    <node pkg="rosserial_python" type="serial_node.py" name="arduino_mega_serial_node" output="screen">
        <param name="port" value="/dev/ttyUSB0"/>
        <param name="baud" value="57600"/>
    </node>

    <!-- 啟動車道辨識節點 -->
    <node pkg="lane_follower" type="lane_detect.py" name="lane_detect" output="screen">
        <!-- 影像輸入裝置的 port (字串路徑或數字 ID) -->
        <param name="video_port" value="/dev/ttyUSB1" />
    </node>

    <!-- 啟動馬達控制節點 -->
    <node pkg="lane_follower" type="lane_controller.py" name="lane_controller" output="screen">
        <!-- 你可以在這邊微調預設參數 -->
        <param name="kp" value="0.005" />
        <param name="kd" value="0.001" />
        <param name="base_speed" value="0.2" />
    </node>
</launch>