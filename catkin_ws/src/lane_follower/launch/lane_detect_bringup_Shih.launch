<launch>
    <!-- rosserial_python 節點 -->
    <node pkg="rosserial_python" type="serial_node.py" name="arduino_mega_serial_node" output="screen">
        <param name="port" value="/dev/ttyUSB0"/>
        <param name="baud" value="115200"/>
    </node>

    <!-- 車道辨識節點 -->
    <node pkg="lane_follower" type="lane_detect_v2.py" name="lane_detect_node" output="screen">
        <param name="image_topic" value="/dev/video0" />
        <param name="pub_topic" value="lane_detect" />
        <param name="debug_topic" value="lane_detect/image_out" />
        <param name="show_window" value="false" />
        
        <!-- Algorithm Configurations -->
        <param name="strict_roi" value="true" />
        <param name="min_contour_area" value="500.0" />
        <param name="anchor_ratio" value="0.75" />
        <param name="lane_width_history_len" value="30" />
        <param name="enable_yaw_b" value="true" />
        <param name="max_predict_frames" value="15" />
    </node>

    <!-- 模糊控制節點 -->
    <node pkg="lane_follower" type="lane_controller_fuzzy.py" name="lane_controller_fuzzy" output="screen">
        <param name="base_speed" value="0.5" />
        <param name="max_angular" value="1.4" />
    </node>
</launch>
